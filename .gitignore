# Local environment files may contain secrets.
.env
.env.*
!.env.example

# Python caches and build artifacts.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments.
.venv/
venv/
env/
ENV/

# Runtime data (retain directory placeholders).
data/uploads/*
!data/uploads/.gitkeep
data/vector_store/*
!data/vector_store/.gitkeep

# MLflow artifacts and local state.
mlruns/
mlartifacts/
.mlflow/

# IDE and editor files.
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
